# Backend API base URL (dev proxies /api to VITE_API_TARGET instead)
VITE_API_URL=https://delta-neutral.hamishgilbert.com/api

# How many days the public site trails live trading. 0 disables the delay.
VITE_DATA_LAG_DAYS=7

# Set to true once the backend honours ?asOf=<ISO> on the public endpoints.
# Until then the delay is applied client-side, which can only cover metrics the
# history endpoint can replay — see docs/data-lag.md.
VITE_API_SUPPORTS_ASOF=false
